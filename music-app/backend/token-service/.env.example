# Crossfade token-service — environment
# In development, any unset secret is replaced with an ephemeral dev value (with a
# warning) so the service boots. In production, all of these are REQUIRED.

NODE_ENV=development
PORT=8787

# HS256 secret used to verify Crossfade account session JWTs.
CROSSFADE_SESSION_SECRET=

# Apple MusicKit signing (from the Apple Developer portal).
APPLE_TEAM_ID=              # 10-char Team ID
APPLE_MUSICKIT_KEY_ID=      # 10-char MusicKit Key ID
# Contents of the .p8 (PKCS#8 PEM). Keep the real key in a secret manager, never in git.
# Single-line values may use literal \n for newlines.
APPLE_MUSICKIT_P8=

# 32-byte base64 master key for the local KMS (envelope-encrypts stored user tokens).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCAL_KMS_MASTER_KEY=

# TTL (seconds) for developer tokens vended to the app. Default 43200 (12h).
DEV_TOKEN_TTL_SECONDS=43200
