{
  "name": "@crossfade/api-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Crossfade API service — implements the Phase-1 OpenAPI contract endpoints (accounts, services, library, search, playlists, import, sync, queue) not covered by the token-service.",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
